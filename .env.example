# Supabase Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Optional: OpenAI API key for semantic vector embeddings (pgvector)
# If omitted or left empty, the server automatically falls back to PostgreSQL Full-Text Search
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Default agent ID if none is supplied in tool calls
DEFAULT_AGENT_ID=default_agent
